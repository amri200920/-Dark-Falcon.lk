# Dark Falcon Server Environment Configuration

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=dark_falcon_ultra_secure_jwt_secret_key_2026_change_in_prod

# Google Gemini AI (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Production Mode)
# When provided, system connects to live Firebase/Firestore.
# When omitted, system runs on high-fidelity zero-config local persistence engine.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WebRTC STUN/TURN Configuration (Optional for NAT traversal)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# SFU Group Video Infrastructure (LiveKit / Mediasoup)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=

# SMS / Phone OTP Provider (Twilio / Firebase Phone Auth)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_ACCOUNT_SID=

# Web Push Notification VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@darkfalcon.io

# Client API Base URL (Frontend)
# In development: Leave blank or set to http://localhost:5000 (proxied by Vite)
# In production: Set to your deployed backend origin (e.g. https://api.darkfalcon.io or Cloud Run URL)
VITE_API_BASE_URL=

# Backend Application URLs
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3005

# PayHere Sri Lankan Payment Gateway (Server-side only)
PAYMENT_MODE=test
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_DEMO_PASSWORD=change-this-demo-password
